// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]

  testAttempts TestAttempt[]

  language String? @default("en")

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ==========================================
// 1. USER & AUTH
// ==========================================

// ==========================================
// 2. THE CATEGORY TREE (Hierarchical)
// ==========================================

model Category {

 id       String         @id @default(cuid())
  name     String
  slug     String
  level    CategoryLevel  // What DEPTH in the tree is this node?
  domain   ExamDomain?    // What KIND of exam is this? (only set at top level)
  parentId String?
  parent   Category?      @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children Category[]     @relation("CategoryHierarchy")
  // Content
  questions Question[]
  tests     TestPaper[]

  @@unique([slug, parentId])
  @@index([slug])
}

enum CategoryLevel {
  ROOT        // Top-level grouping (replaces EXAM_BODY)
  EXAM        // Specific exam name (replaces EXAM_NAME)
  STANDARD    // Class/grade level
  SUBJECT     // Subject within a standard
  CHAPTER     // Chapter within a subject
  PYQ         // Previous year questions
}
enum ExamDomain {
  BOARD        // BSEB, CBSE, ICSE
  COMPETITIVE  // SSC, RRB, UPSC, BPSC
  ENTRANCE     // JEE, NEET, CUET
  OLYMPIAD     // IMO, NSO, NTSE
  LANGUAGE     // IELTS, TOEFL
  UNIVERSITY   // BHU UET, DU
  RECRUITMENT  // State PSC, police, army
  SCHOLARSHIP  // NMMS, INSPIRE
  VOCATIONAL   // ITI, polytechnic
}

// ==========================================
// 3. QUESTION BANK
// ==========================================

model Question {
  id           String       @id @default(cuid())
  // Multi-language: { "en": "What is..", "hi": "Kya hai.." }
  content      Json
  imageUrl     String?
  type         QuestionType
  difficulty   Difficulty   @default(MEDIUM)
  // { "en": "Explanation..", "hi": "Vivaran.." }
  solution     Json? // Array of options with language support
  options      Json?
  correctValue String? // Organization
  categoryId   String
  category     Category     @relation(fields: [categoryId], references: [id])

  // Relations
  usedInTests TestQuestion[]
  responses   StudentResponse[]

  createdAt DateTime @default(now())
}

enum QuestionType {
  MCQ_SINGLE
  MCQ_MULTIPLE
  INTEGER
  NUMERICAL
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// ==========================================
// 4. TEST PAPERS
// ==========================================

model TestPaper {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String?
  // Summary of languages available in this test
  languages   String[] @default(["en"]) // <--- FIX: Lowercase "en" is standard
  duration    Int
  totalMarks  Int
  isPublished Boolean  @default(false)

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  questions TestQuestion[]
  attempts  TestAttempt[]

  createdAt DateTime  @default(now())
  updatedAt DateTime? @updatedAt
}

model TestQuestion {
  id            String    @id @default(cuid())
  testPaperId   String
  testPaper     TestPaper @relation(fields: [testPaperId], references: [id])
  questionId    String
  question      Question  @relation(fields: [questionId], references: [id])
  positiveMarks Float
  negativeMarks Float
  orderIndex    Int

  @@unique([testPaperId, questionId])
}

// ==========================================
// 5. USER ATTEMPTS & ANALYTICS
// ==========================================

model TestAttempt {
  id          String        @id @default(cuid())
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  testPaperId String
  testPaper   TestPaper     @relation(fields: [testPaperId], references: [id])
  score       Float?
  status            AttemptStatus @default(STARTED)
  startedAt         DateTime      @default(now())
  submittedAt       DateTime?
  hasStartedSession Boolean       @default(false)
  language          String        @default("en")

  responses StudentResponse[]
}

model StudentResponse {
  id         String      @id @default(cuid())
  attemptId  String
  attempt    TestAttempt @relation(fields: [attemptId], references: [id])
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])
  userAnswer String?
  isCorrect  Boolean     @default(false)
  timeTaken  Int // <--- CRITICAL FIX BELOW:
  // This constraint is required for prisma.studentResponse.upsert()
  // It ensures a student can't have 2 answers for the same question in one attempt.
  @@unique([attemptId, questionId])
}

enum AttemptStatus {
  STARTED
  PAUSED
  COMPLETED
}

model keep_alive_logs {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  source     String   @default("keep-alive-saas")
  created_at DateTime @default(now()) @db.Timestamptz
}
